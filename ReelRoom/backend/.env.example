# ReelRoom backend
# Copy this file to `.env` and fill in your values.

# Port the HTTP + WebSocket server listens on
PORT=4000

# Set to "production" when deploying
NODE_ENV=development

# Allowed browser origin for CORS (or * during local development)
CLIENT_ORIGIN=*

# MongoDB connection string. The server still boots if this is unset or
# unreachable — rooms and users fall back to local JSON storage in ./data/.
MONGO_URI=

# Secret used to sign and verify JWTs. Set a long random value in production.
JWT_SECRET=
